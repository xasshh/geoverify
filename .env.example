APP_NAME=GeoVerify
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=geoverify
DB_USERNAME=geoverify
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@logyon.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Set to the load balancer or tunnel in front of the app, or "*" when it is
# the only way in. Empty means forwarded headers are ignored.
TRUSTED_PROXIES=

# Paystack. The secret key signs the webhook, which is the only thing this
# application believes about money: unset, no payment can be started and no
# notification can be verified, and both fail loudly rather than on trust.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Enumerate's registry lookups (CAC, TIN). fake answers from a fixed list and
# refuses to run in production; dojah needs both keys from the Dojah dashboard.
REGISTRY_DRIVER=fake
DOJAH_BASE_URL=https://sandbox.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=

# Text messages (sign-in and claim codes). log writes them to the log and only
# runs locally; termii needs the API key, the base URL shown on your Termii
# dashboard and a sender ID Termii has approved for the dnd channel.
# Off since 2026-10-09: accounts are proved by email. On only for the
# browser specs, which read sign-in codes back from the log.
SMS_ENABLED=false
SMS_DRIVER=log
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=dnd

# Merchant hub fees, in kobo. Unset means not yet decided, and the service
# cannot be bought. Commission is basis points of the goods (250 = 2.5%).
GEOVERIFY_DELIVERY_FEE_MINOR=350000
GEOVERIFY_INSPECTION_FEE_MINOR=
GEOVERIFY_VISIT_FEE_MINOR=
GEOVERIFY_COMMISSION_BASIS_POINTS=0
GEOVERIFY_RELEASE_AFTER_DAYS=7
